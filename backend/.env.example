# ==============================================================
# DocuScan Burkina - Backend - Variables d'environnement
# ==============================================================
# Copiez ce fichier en .env et renseignez de vraies valeurs.
# NE JAMAIS committer le fichier .env avec de vraies clés dans Git.

NODE_ENV=development
PORT=3000

# --- CORS ---
# Liste d'origines autorisées séparées par des virgules
# (ex: https://docuscan-burkina.vercel.app,https://app.docuscanburkina.com)
# Laissez vide pour autoriser toutes les origines (dev uniquement).
CORS_ORIGINS=

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=docuscan
# Mettre à true en production sur Render (SSL requis)
DB_SSL=false
# Ne JAMAIS activer en production : utiliser les migrations (npm run migration:run)
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- JWT ---
# Générez des secrets forts, par ex: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# --- Saspay (paiement) ---
# Documentation officielle: https://docs.saspay.me
# Obtenez votre clé API depuis https://app.saspay.me (section Développeur)
# Utilisez sk_test_... pour les tests, sk_live_... en production
SASPAY_API_KEY=
SASPAY_BASE_URL=https://api.saspay.me/api/v1
# Secret de signature webhook, affiché UNE SEULE FOIS à la création du
# webhook sur le dashboard Saspay (Webhooks -> Créer / Changer le secret)
SASPAY_WEBHOOK_SECRET=
SASPAY_DEFAULT_COUNTRY=BF
SASPAY_DEFAULT_CURRENCY=XOF
# URL de retour après paiement checkout hébergé réussi
SASPAY_RETURN_URL=https://votre-pwa.vercel.app/paiement/succes

# --- Compte admin initial (créé automatiquement au premier démarrage) ---
ADMIN_BOOTSTRAP_EMAIL=admin@docuscanburkina.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMoiImmediatement123!

# --- Règles métier ---
FCFA_PER_CREDIT=50
