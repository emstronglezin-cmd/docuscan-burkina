# DocuScan Burkina - Mobile (Flutter)
# ======================================
# Ce projet n'utilise pas de fichier .env classique (Flutter ne lit pas
# les fichiers .env nativement). La configuration se fait via
# --dart-define au moment du build/run.
#
# Variable disponible: API_BASE_URL
#   URL de base du backend NestJS (SANS slash final, SANS /api/v1,
#   celui-ci est ajouté automatiquement par lib/services/api_client.dart)
#
# Exemple pour developper en local contre un backend sur la meme machine:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3000
#
# Exemple pour builder un APK de production contre le backend Render:
#   flutter build apk --release \
#     --dart-define=API_BASE_URL=https://docuscan-burkina-api.onrender.com
#
# Si --dart-define n'est pas fourni, la valeur par defaut definie dans
# lib/config/app_config.dart est utilisee (URL du backend de
# developpement dans le sandbox). PENSEZ A LA CHANGER avant tout build
# de production destine a etre distribue publiquement.
